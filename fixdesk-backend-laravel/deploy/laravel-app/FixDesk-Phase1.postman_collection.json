              "raw": "{\n  \"us_phone\": \"0888888888\",\n  \"us_department\": \"HR (แก้ไขเอง)\",\n  \"oldPassword\": \"Somchai@9999J\"\n}"
            },
            "url": "{{base_url}}/edit-personal/{{new_user_id}}",
            "description": "endpoint นี้ไม่ต้อง login — ต้องใส่ oldPassword ให้ถูก (ยกเว้น isFirstLogin=true) รหัสผ่าน default ของ user นี้คือ Somchai@9999J ตามสูตร generateDefaultPassword (firstNameEn@last4phoneLastInitial)"
          }
        },
        {
          "name": "Import Users",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"users\": [\n    {\n      \"username\": \"import01\",\n      \"first_name_th\": \"นำเข้า\",\n      \"last_name_th\": \"ทดสอบ\",\n      \"first_name_en\": \"Import\",\n      \"last_name_en\": \"Test\",\n      \"phone\": \"0877777777\",\n      \"role_name\": \"User\",\n      \"title_name\": \"นาย\",\n      \"department\": \"IT\",\n      \"position\": \"Tester\"\n    }\n  ]\n}"
            },
            "url": "{{base_url}}/users/import"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/users/{{new_user_id}}",
            "description": "รันตัวนี้ตัวสุดท้ายของโฟลเดอร์นี้ — ลบ user ที่สร้างไว้ทดสอบทิ้ง"
          }
        }
      ]
    },
