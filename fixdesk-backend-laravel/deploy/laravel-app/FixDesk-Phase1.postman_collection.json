          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"us_user_name\": \"user01\",\n  \"us_first_name_th\": \"สมชาย\",\n  \"us_last_name_th\": \"ใจดี\",\n  \"us_first_name_en\": \"Somchai\",\n  \"us_last_name_en\": \"Jaidee\",\n  \"us_phone\": \"0899999999\",\n  \"us_department\": \"HR\",\n  \"us_role_id\": 3,\n  \"us_job_title\": \"Staff\"\n}"
            },
            "url": "{{base_url}}/users",
            "description": "endpoint นี้ไม่ต้อง login (ตรงกับต้นฉบับ) — us_first_name_th/us_last_name_th ต้องเป็นภาษาไทยล้วนเท่านั้น ไม่งั้นโดน validation reject. รหัสผ่านเริ่มต้นจะ gen อัตโนมัติจาก first_name_en + เบอร์ 4 ตัวท้าย + ตัวอักษรแรกของนามสกุล_en (ดูสูตรได้ใน UserService::generateDefaultPassword)"
          }
        },
        {
          "name": "Get User By Id (admin view)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/users/{{new_user_id}}"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"us_first_name_th\": \"สมชาย\",\n  \"us_last_name_th\": \"ใจดีมาก\",\n  \"us_role_id\": 3,\n  \"us_job_title\": \"Senior Staff\"\n}"
            },
            "url": "{{base_url}}/users/{{new_user_id}}"
          }
        },
        {
          "name": "Reset Password",
          "request": {
