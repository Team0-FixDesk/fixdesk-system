          "name": "Get Rooms (all)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/rooms"
          }
        },
        {
          "name": "Get Rooms by Floor",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/rooms/{{new_fl_id}}"
          }
        },
        {
          "name": "Create Room",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.room_id) { pm.collectionVariables.set('new_room_id', data.room_id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_name\": \"ห้อง 201\",\n  \"room_fl_id\": {{new_fl_id}}\n}"
            },
            "url": "{{base_url}}/rooms"
          }
        },
        {
          "name": "Update Room",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_name\": \"ห้อง 201 (แก้ไข)\",\n  \"room_fl_id\": {{new_fl_id}}\n}"
            },
            "url": "{{base_url}}/rooms/{{new_room_id}}"
          }
        },
        {
          "name": "Check Usage (room, not used)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/locations/check-usage/room/{{new_room_id}}"
          }
        },
        {
          "name": "Import Locations",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"locations\": [\n    { \"building_name\": \"อาคาร 3\", \"floor_name\": \"ชั้น 1\", \"room_name\": \"ห้อง 301\" }\n  ]\n}"
            },
            "url": "{{base_url}}/locations/import",
            "description": "สร้าง building/floor/room อัตโนมัติถ้ายังไม่มี (match ชื่อแบบ case-insensitive) — ใช้ import ข้อมูลสถานที่ทีละหลายรายการ"
          }
        },
        {
          "name": "Delete Room",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/rooms/{{new_room_id}}",
            "description": "ต้องลบ Room ก่อน Floor ก่อน Building เสมอ (ลำดับ dependency) — ถ้ามีใบแจ้งซ่อมผูกกับห้องนี้จะลบไม่ได้"
          }
        },
        {
          "name": "Delete Floor",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/floors/{{new_fl_id}}"
          }
        },
        {
          "name": "Delete Building",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/buildings/{{new_bd_id}}"
          }
        }
      ]
    }
  ]
}
