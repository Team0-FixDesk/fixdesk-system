            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/users/{{new_user_id}}/reset-password"
          }
        },
        {
          "name": "Get Personal Profile (no auth, /user/:id)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/user/{{new_user_id}}"
          }
        },
        {
          "name": "Edit Personal Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
